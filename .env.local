# Rails 环境 (生产用 production，开发用 development)
RAILS_ENV=production
RACK_ENV=production

# 数据库配置 (使用 DATABASE_URL，Rails 标准方式)
DATABASE_URL=postgresql://suxiongye@host.docker.internal:5432/discourse_production

# Redis 配置
DISCOURSE_REDIS_HOST=host.docker.internal
DISCOURSE_REDIS_PORT=6379

# 域名配置 (本地测试)
DISCOURSE_HOSTNAME=orcaspace.local
DISCOURSE_DEV_HOSTS=orcaspace.local

# 开发者邮箱 (用于创建管理员)
DISCOURSE_DEVELOPER_EMAILS=admin@example.com

# Rails Secret (生产环境必须用强密码)
SECRET_KEY_BASE=production_secret_key_base_min_30_chars_long_replace_this

# 启用静态资源服务 (生产环境需要)
DISCOURSE_SERVE_STATIC_ASSETS=true

# 跳过邮件配置 (开发环境不需要真实邮件)
DISCOURSE_SMTP_ADDRESS=
DISCOURSE_SMTP_PORT=
 # HTTPS 关掉（本地不需要）                                                                               
  DISCOURSE_FORCE_HTTPS=false                                                                              
  RAILS_ASSUME_SSL=false                                                                                   
                                                                                                           
  # COS 存储（如果要测试上传）                                                                             
  DISCOURSE_ENABLE_S3_UPLOADS=true                                                                                                              
  DISCOURSE_S3_REGION=ap-guangzhou                                                                         
  DISCOURSE_S3_BUCKET=orcaspace-1255940152                                                                 
  DISCOURSE_S3_UPLOAD_BUCKET=orcaspace-1255940152                                                          
  DISCOURSE_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com                                              
                                                                                                           
  # 太湖认证（本地可以关掉）                                                                               
  DISCOURSE_TAI_HU_AUTH_ENABLED=false                                                                      
                                                                                                           
  # 超时和限流                                                                                             
  UNICORN_TIMEOUT=180                                                                                      
  DISCOURSE_MAX_REQS_PER_IP_MODE=none        